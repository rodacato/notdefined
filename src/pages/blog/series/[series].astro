---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CardList from '../../../components/CardList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { readingTime } from '../../../utils/reading-time';
import { seriesByName, statusLabel } from '../../../data/series';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft && !!data.series,
  );

  const seriesMap = new Map<string, CollectionEntry<'blog'>[]>();
  for (const post of posts) {
    const series = post.data.series!;
    if (!seriesMap.has(series)) seriesMap.set(series, []);
    seriesMap.get(series)!.push(post);
  }

  const orderedNames = [...seriesMap.keys()]
    .map((name) => ({ name, order: seriesByName(name)?.order ?? 999 }))
    .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name))
    .map((s) => s.name);

  return [...seriesMap.entries()].map(([series, seriesPosts]) => {
    const i = orderedNames.indexOf(series);
    return {
      params: { series },
      props: {
        series,
        posts: seriesPosts.sort(
          (a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0),
        ),
        next: orderedNames[i + 1] ?? null,
      },
    };
  });
}

const { series, posts, next } = Astro.props as {
  series: string;
  posts: CollectionEntry<'blog'>[];
  next: string | null;
};
const meta = seriesByName(series);
const totalMin = posts.reduce((sum, p) => sum + readingTime(p.body), 0);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-MX', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={`${series} — notdefined.dev`}
  description={`Serie "${series}" en notdefined.dev (${posts.length} partes).`}
>
  <PageHeader
    backHref="/blog/series/"
    backLabel="← Todas las series"
    label={meta ? statusLabel[meta.status] : 'Series'}
    title={series}
    description={meta?.thesis ??
      `${posts.length} parte${posts.length !== 1 ? 's' : ''} · En orden de lectura`}
  />

  <p class="series-lead">
    {posts.length} parte{posts.length !== 1 ? 's' : ''} · {totalMin} min de lectura
    · En orden
  </p>

  <CardList as="ol" class="series-list">
    {
      posts.map((post, i) => (
        <li class="card-list-item">
          <a href={`/blog/${post.slug}/`} class="post-link">
            <span class="part-num">{i + 1}</span>
            <div class="post-meta">
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
            </div>
            <div class="post-right">
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
              <span class="read-time">{readingTime(post.body)} min</span>
            </div>
          </a>
        </li>
      ))
    }
  </CardList>

  <nav class="series-footer" aria-label="Navegación entre series">
    {
      next && (
        <a
          href={`/blog/series/${encodeURIComponent(next)}/`}
          class="next-series"
        >
          <span class="next-label">Sigue con</span>
          <span class="next-name">{next} →</span>
        </a>
      )
    }
    <a href="/blog/series/" class="all-series">Todas las series</a>
  </nav>
</BaseLayout>

<style>
  .series-lead {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .series-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    transition: background-color 150ms ease;
    text-decoration: none;
  }
  .post-link:hover {
    background-color: var(--color-surface);
  }

  .part-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    opacity: 0.7;
    min-width: 1.25rem;
    padding-top: 0.2rem;
    flex-shrink: 0;
  }

  .post-meta {
    flex: 1;
    min-width: 0;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    display: block;
    margin: 0 0 0.25rem;
  }
  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .post-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .post-date {
    font-size: 0.78rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .read-time {
    font-size: 0.72rem;
    color: var(--color-muted);
    white-space: nowrap;
    opacity: 0.7;
  }

  /* End-of-series nav (#5) */
  .series-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .next-series {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .next-label {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .next-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 120ms ease;
  }
  .next-series:hover .next-name {
    color: var(--color-accent);
  }
  .all-series {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .all-series:hover {
    color: var(--color-accent);
  }

  /* Responsive: stack the date/read-time under the title on narrow screens (#6) */
  @media (max-width: 560px) {
    .post-link {
      flex-wrap: wrap;
    }
    .post-meta {
      flex-basis: calc(100% - 2.25rem);
    }
    .post-right {
      flex-direction: row;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      padding-left: 2.25rem;
      padding-top: 0.4rem;
    }
  }
</style>
