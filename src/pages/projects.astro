---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import TagPill from '../components/TagPill.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const VISIBLE_STACK = 4;

const projects = (await getCollection('projects')).sort(
  (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

const writingTitles = new Map<string, string>([
  ...(await getCollection('blog', (p) => !p.data.draft)).map(
    (p) => [`/blog/${p.slug}/`, p.data.title] as const,
  ),
  ...(await getCollection('til')).map(
    (t) => [`/til/${t.slug}/`, t.data.title] as const,
  ),
]);

const writingFor = (project: CollectionEntry<'projects'>) =>
  project.data.posts.map((href) => {
    const title = writingTitles.get(href);
    if (!title) throw new Error(`${project.id}: no published post at ${href}`);
    return { href, title };
  });
---

<BaseLayout
  title="Proyectos — notdefined.dev"
  description="Proyectos y experimentos de Adrian Castillo."
>
  <PageHeader
    label="Trabajo"
    title="Proyectos"
    description="Cosas que construyo, experimento o sigo desarrollando."
  />

  <div class="projects-grid">
    {
      projects.map((project, i) => {
        const { data } = project;
        const writing = writingFor(project);
        const extraStack = data.stack.slice(VISIBLE_STACK);
        return (
          <article
            class="project-card fade-in-item"
            style={`--accent: ${data.accent ?? '#6366f1'}`}
          >
            {data.image && (
              <img
                class="project-shot"
                src={data.image}
                alt={`Captura de ${data.name}`}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            )}

            <div class="project-body">
              <div class="project-head">
                <span class="project-icon" aria-hidden={!data.icon}>
                  {data.icon ? (
                    <img src={data.icon} alt="" />
                  ) : (
                    data.name.charAt(0)
                  )}
                </span>
                <div class="project-id">
                  <h2 class="project-name">{data.name}</h2>
                  <p class="project-tagline">{data.tagline}</p>
                </div>
              </div>

              {data.why && <p class="project-why">{data.why}</p>}
              <p class="project-desc">{data.product}</p>

              <div class="project-pills">
                {data.stack.slice(0, VISIBLE_STACK).map((item: string) => (
                  <TagPill label={item} />
                ))}
              </div>

              {writing.length > 0 && (
                <div class="project-writing">
                  <p class="project-writing-label">Escribí sobre esto</p>
                  <ul>
                    {writing.map((post) => (
                      <li>
                        <a href={post.href}>{post.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="project-actions">
                <a
                  href={data.site ?? data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-cta"
                >
                  {data.site ? 'Ver el sitio' : 'Ver en GitHub'} ↗
                </a>
                {data.site && (
                  <a
                    href={data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-ext"
                    aria-label={`${data.name} en GitHub`}
                  >
                    GitHub ↗
                  </a>
                )}
              </div>

              <details class="project-more">
                <summary>Ver detalles</summary>
                <div class="project-more-body">
                  <p class="project-tech">{data.technical}</p>
                  {extraStack.length > 0 && (
                    <div class="project-pills">
                      {extraStack.map((item: string) => (
                        <TagPill label={item} />
                      ))}
                    </div>
                  )}
                </div>
              </details>
            </div>
          </article>
        );
      })
    }
  </div>

  <aside class="labs-cta">
    <div class="labs-cta-text">
      <p class="labs-cta-eyebrow">Experimentos</p>
      <h2 class="labs-cta-title">¿Y lo experimental?</h2>
      <p class="labs-cta-desc">
        Cosas que se corren, no que se leen: visualizaciones, catálogos y
        juguetes técnicos.
      </p>
    </div>
    <a href="/lab/" class="labs-cta-btn">Ir a Labs →</a>
  </aside>
</BaseLayout>

<style>
  .labs-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding: 1.6rem 1.8rem;
    border: 1px solid
      color-mix(in oklab, var(--color-accent) 28%, var(--color-border));
    border-radius: 0.9rem;
    background-color: color-mix(
      in oklab,
      var(--color-accent) 6%,
      var(--color-bg)
    );
  }
  .labs-cta-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .labs-cta-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.3rem;
  }
  .labs-cta-desc {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
    max-width: 34rem;
  }
  .labs-cta-btn {
    flex-shrink: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background-color: var(--color-accent);
    border-radius: 0.6rem;
    padding: 0.7rem 1.3rem;
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .labs-cta-btn:hover {
    opacity: 0.88;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    overflow: hidden;
    background-color: var(--color-bg);
    transition: border-color 150ms ease-out;
  }
  .project-card:hover {
    border-color: var(--accent);
  }

  .project-shot {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: left top;
    border-bottom: 1px solid var(--color-border);
  }

  .project-body {
    padding: 1.4rem;
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 0.6rem;
    background-color: var(--accent);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    overflow: hidden;
  }
  .project-icon:has(img) {
    background-color: #fff;
    border: 1px solid var(--color-border);
    padding: 5px;
  }
  .project-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-id {
    flex: 1;
    min-width: 0;
  }

  .project-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .project-tagline {
    font-size: 0.83rem;
    color: var(--accent);
    font-weight: 500;
    margin: 0.15rem 0 0;
    line-height: 1.4;
  }

  .project-why {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.55;
    margin: 1rem 0 0;
  }

  .project-writing {
    margin-top: 1.1rem;
  }
  .project-writing-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.35rem;
  }
  .project-writing ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  .project-writing a {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
    text-underline-offset: 0.2em;
    line-height: 1.4;
    transition: text-decoration-color 150ms ease-out;
  }
  .project-writing a:hover {
    text-decoration-color: var(--accent);
  }

  .project-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin-top: 1.25rem;
  }
  .project-ext {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .project-ext:hover {
    color: var(--accent);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0.9rem 0 0;
  }

  .project-pills {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .project-more {
    margin-top: 1.1rem;
  }
  .project-more summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    transition: opacity 150ms ease;
  }
  .project-more summary::-webkit-details-marker {
    display: none;
  }
  .project-more summary::after {
    content: '▸';
    transition: transform 150ms ease-out;
  }
  .project-more[open] summary::after {
    transform: rotate(90deg);
  }
  .project-more summary:hover {
    opacity: 0.75;
  }

  .project-more-body {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .project-tech {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 0;
  }
  .project-tech + .project-pills {
    margin-top: 0.85rem;
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background-color: var(--accent);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 150ms ease-out;
  }
  .project-cta:hover {
    opacity: 0.9;
  }
</style>
